{
    "name": "todo-ls",
    "keywords": [
        "lsp",
        "language-server",
        "todo.txt"
    ],
    "version": "0.3-beta",
    "homepage": "https://github.com/pursvir/todo-ls",
    "description": "Language server implementation for todo.txt files.",
    "license": "MIT",
    "author": "pursvir",
    "type": "commonjs",
    "repository": {
        "type": "git",
        "url": "https://github.com/pursvir/todo-ls"
    },
    "bugs": {
        "url": "https://github.com/pursvir/todo-ls/issues"
    },
    "scripts": {
        "preinstall": "tsc",
        "build": "tsc && npx add-shebang",
        "format": "npx prettier --write src/",
        "lint": "npx eslint",
        "test": "npx jest"
    },
    "dependencies": {
        "node-fetch": "^2.7.0",
        "vscode-languageclient": "^10.1.0",
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-textdocument": "^1.0.13"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.2",
        "@types/node-fetch": "^2.6.13",
        "@types/vscode": "^1.105.0",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "@typescript-eslint/parser": "^8.60.1",
        "eslint": "^10.4.1",
        "prettier": "^3.8.3",
        "ts-jest": "^29.4.12",
        "typescript": "^5.9.3"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "main": "./dist/index.js",
    "bin": {
        "todo-ls": "./dist/index.js"
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true,
        "todo-ls": true
    }
}
