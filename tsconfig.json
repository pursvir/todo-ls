{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ES2020",
		"removeComments": true,
		"esModuleInterop": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"strictNullChecks": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"noImplicitAny": false,
		"noFallthroughCasesInSwitch": false,
		"allowSyntheticDefaultImports": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "dist_tests", "tests/**/*"]
}
