import { Token } from "../parser/tokenTypes";
import { TextDocumentContentChangeEvent } from "../_overrides/overrideChangeEvent";
import { getIndexAtPosition, getTokenEnd } from "../tokenctl/utils";
import { getTokenizedText } from "../parser/tokenizer";
import { positionIsInsideToken } from "../tokenctl/utils";
import { encodeTokenType } from "../parser/utils";
import { determineTodotxtTokenType } from "../parser/lexer";

const getMergedToken = (token1: Token, token2: Token): Token | null =>  {
  if (
    token1.character <= token2.character
    && token2.character <= getTokenEnd(token1)
  ) {
    return {
      ...token1,
      content: token1.content.slice(
        0, token2.character - getTokenEnd(token1)
      ) + token2.content
    }
  }
  return null;
}

/**
 * Returns new token list and splice index shift for next delta updates in TextDocumentContentChangeEvent[].
*/
export const deltaChangeTokens = (
  tokens: Token[],
  change: TextDocumentContentChangeEvent,
  spliceStartShift: number = 0,
): [Token[], number] => {
  const oldLength: number = tokens.length;
  const pastedTokens: Token[] = getTokenizedText(
    change.text, change.range.start.line, change.range.start.character
  );

  const spliceStartIndex: number = getIndexAtPosition(
    tokens, change.range.start, true,
  );
  const spliceEndIndex: number = getIndexAtPosition(
    tokens, change.range.end, true,
  );
  let spliceExtra: number = 0;

  let lineShift: number =
    change.range.end.line - change.range.start.line +
    ((): number => {
      let previousLine: number = change.range.start.line;
      let sum: number = 0;
      for (let i: number = 0; i < pastedTokens.length; i++) {
        if (pastedTokens[i].line !== previousLine) sum++;
        previousLine = pastedTokens[i].line;
      }
      return sum;
    })();
  const charShift: number =
    // pastedTokens[pastedTokens.length - 1]?.character + pastedTokens[pastedTokens.length - 1]?content.length ?? 0
    change.text.length - change.range.end.character + change.range.start.character;
  console.log(`Line shift: ${lineShift}, charShift: ${charShift}`);

  // Changing first and last pasted text tokens content based on surrounding old tokens info.
  // TODO: change token types!
  if (pastedTokens.length >= 1) {
    let ind: number = spliceStartIndex === tokens.length ? spliceStartIndex - 1 : spliceStartIndex;
    const newContent: string = tokens[ind].content.slice(
      0, change.range.start.character - tokens[ind].character
    ) + pastedTokens[0].content;
    pastedTokens[0] = {
      ...pastedTokens[0],
      content: newContent,
      tokenType: encodeTokenType(determineTodotxtTokenType(
        newContent, pastedTokens[0].line, pastedTokens[0].character, tokens // .slice(...)
      ))
    }

    // pasted one letter inside a word
    if (
      (spliceStartIndex < tokens.length - 1)
      && positionIsInsideToken({
        line: pastedTokens[0].line,
        character: getTokenEnd(pastedTokens[0])
      }, tokens[spliceStartIndex + 1])
    ) {
      const newContent: string = tokens[spliceStartIndex + 1].content;
      pastedTokens[0] = {
        ...pastedTokens[0],
        content: pastedTokens[0] + newContent,
        tokenType: encodeTokenType(determineTodotxtTokenType(
          newContent, pastedTokens[0].line, pastedTokens[0].character, tokens // .slice(...)
        ))
      }
      // spliceExtra++;
    }

    if (pastedTokens.length > 1) {
      if (positionIsInsideToken(change.range.end, tokens[spliceEndIndex])) {
        ind = spliceEndIndex === tokens.length ? spliceEndIndex - 1 : spliceEndIndex;
        pastedTokens[pastedTokens.length - 1].content +=
          tokens[ind].content.slice(
            change.range.end.character - tokens[ind].character
          );
      }
    }
  }

  tokens.splice(
    spliceStartIndex + spliceStartShift,
    spliceEndIndex - spliceStartIndex + spliceExtra,
    ...pastedTokens,
  );
  spliceStartShift += tokens.length - oldLength;

  // Shifting .line and .char attributes of the rest of the tokens.
  for (
    let i: number = spliceStartIndex + pastedTokens.length;
    i < tokens.length;
    i++
  ) {
    // TODO: it's incorrect
    if (tokens[i].line === change.range.end.line)
      tokens[i].character += charShift;
    tokens[i].line += lineShift;
  }

  return [tokens, spliceStartShift];
};
